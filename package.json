{
  "name": "root",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thienvu18/antd.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "audit:deprecated": "node scripts/audit-deprecated-apis.cjs",
    "build": "node scripts/build-packages.cjs",
    "build:docs": "dumi build",
    "lint": "eslint .",
    "release": "lerna publish from-package --yes",
    "start": "dumi dev",
    "test": "jest --coverage",
    "test:prod": "jest --coverage --silent",
    "typecheck": "tsc --noEmit --project packages/components/tsconfig.json && tsc --noEmit --project packages/prototypes/tsconfig.json && tsc --noEmit --project packages/renderer/tsconfig.json && tsc --noEmit --project packages/setters/tsconfig.json && tsc --noEmit --project packages/settings-form/tsconfig.json",
    "verify": "corepack yarn audit:deprecated && corepack yarn lint && corepack yarn typecheck && corepack yarn build && corepack yarn build:docs && CI=true corepack yarn test:prod --runInBand && corepack yarn verify:pack",
    "verify:pack": "node scripts/verify-pack.cjs",
    "preversion": "corepack yarn install --immutable && npm run build && npm run lint",
    "version:alpha": "lerna version prerelease --preid alpha",
    "version:beta": "lerna version prerelease --preid beta",
    "version:major": "lerna version major",
    "version:minor": "lerna version minor",
    "version:patch": "lerna version patch",
    "version:preminor": "lerna version preminor --preid beta",
    "version:rc": "lerna version prerelease --preid rc"
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --ext .ts,.tsx,.js",
      "pretty-quick --staged",
      "git add"
    ],
    "*.md": [
      "pretty-quick --staged",
      "git add"
    ]
  },
  "config": {
    "ghooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint --edit"
    }
  },
  "resolutions": {
    "less-loader@npm:11.1.0": "npm:12.3.3",
    "postcss@npm:8.5.26": "npm:8.4.31",
    "postcss@npm:^8.4.21": "npm:8.4.31",
    "react-helmet-async": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "^17.3.0",
    "@commitlint/config-conventional": "^17.3.0",
    "@commitlint/prompt-cli": "^17.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.1",
    "@types/fs-extra": "^9.0.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.11.9",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "antd": "^6.6.2",
    "cross-env": "^7.0.3",
    "dumi": "^2.4.49",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^8.5.0",
    "fs-extra": "^10.1.0",
    "ghooks": "^2.0.4",
    "glob": "^8.0.3",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "lerna": "^8.2.4",
    "less": "^4.2.0",
    "less-loader": "^12.3.3",
    "lint-staged": "^13.0.4",
    "mfetch": "^0.2.27",
    "moment": "^2.29.4",
    "postcss": "8.4.31",
    "prettier": "^2.2.1",
    "pretty-format": "^29.3.1",
    "pretty-quick": "^3.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "rimraf": "^3.0.0",
    "staged-git-files": "^1.1.2",
    "styled-jsx": "^5.1.6",
    "to-fast-properties": "^2.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "5.2.2",
    "webpack": "^5.99.0"
  },
  "packageManager": "yarn@4.6.0",
  "engines": {
    "node": ">=20 <25"
  }
}
